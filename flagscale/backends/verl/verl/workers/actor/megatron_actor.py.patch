+
+    def _process_with_original_batching(
+        self,
+        mini_batch: DataProto,
+        use_dynamic_bsz: bool,
+        micro_batch_size: Optional[int],
+        max_token_len: Optional[int],
+    ) -> Tuple[List[TensorDict], Optional[List[List[int]]], int]:
+        """Process batch using original VERL batching logic.
+
+        Args:
+            mini_batch: Input mini-batch.
+            use_dynamic_bsz: Whether to use dynamic batch size.
+            micro_batch_size: Micro-batch size for non-dynamic batching.
+            max_token_len: Maximum token length for dynamic batching.
+
+        Returns:
+            Tuple of (micro_batches, indices, total_seqlen).
+        """
+        indices = None
+        if use_dynamic_bsz:
+            assert max_token_len is not None, "max_token_len must be set when use_dynamic_bsz is True"
+            # Get sequence packing config if available
+            sequence_packing_config = None
+            if self.config.actor_rollout_ref.actor.sequence_packing:
+                sequence_packing_config = self.config.actor_rollout_ref.actor.sequence_packing
+            
+            vpp_size = mpu.get_virtual_pipeline_model_parallel_world_size()
+            if vpp_size is not None and vpp_size > 1:
+                microbatch_group_size_per_vp_stage = self.tf_config.microbatch_group_size_per_vp_stage
+                micro_batches, indices = rearrange_micro_batches(
+                    batch=mini_batch.batch,
+                    num_batches_divided_by=microbatch_group_size_per_vp_stage,
+                    max_token_len=max_token_len,
+                    sequence_packing_config=sequence_packing_config,
+                )
+                assert len(micro_batches) % self.tf_config.microbatch_group_size_per_vp_stage == 0, (
+                    f"micro_batches {micro_batches} must be divisible by microbatch_group_size_per_vp_stage "
+                    f"{microbatch_group_size_per_vp_stage} for megatron backend"
+                )
+            else:
+                micro_batches, indices = rearrange_micro_batches(
+                    batch=mini_batch.batch, 
+                    max_token_len=max_token_len,
+                    sequence_packing_config=sequence_packing_config,
+                )
+            total_seqlen = max_token_len
+        else:
+            assert micro_batch_size is not None, (
+                "micro_batch_size is needed to be passed in when not using dynamic batch size"
+            )
+            micro_batches = mini_batch.batch.split(micro_batch_size)
+            seq_len = micro_batches[0]["input_ids"].shape[1]
+            total_seqlen = micro_batch_size * seq_len
+
+        return micro_batches, indices, total_seqlen
